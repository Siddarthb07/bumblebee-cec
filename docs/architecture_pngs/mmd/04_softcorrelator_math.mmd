flowchart TD
  q[q_in_R_d] --> Wq[W_q_q]
  P[P_in_R_T_x_d] --> Wk[W_k_P_t]
  Wq --> Dot["logits_t = dot / temperature"]
  Wk --> Dot
  Mask[passage_mask] --> Dot
